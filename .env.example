DATABASE_URL=postgresql://onda:local_password_change_me@localhost:5432/onda
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exact origin used for links and OAuth callback; HTTPS in production.
APP_URL=http://localhost:3000
# Explicitly enable only after staging acceptance. Defaults to false.
ALLOW_LIVE_PAYMENTS=false
# Public media hostnames, comma-separated. No wildcard or Drive links.
MEDIA_HOSTS=images.unsplash.com
# Bootstrap only: define locally, run admin:create, then remove these variables.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
# Optional persistent login username; email login remains available.
ADMIN_USERNAME=
# Only for a localhost preview with live payments disabled.
ONDA_LOCAL_PREVIEW=false
